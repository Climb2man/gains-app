# ─── Gains iOS release/signing config ───────────────────────────────────────
# Copy to .env (gitignored) and fill in. Only the RELEASE / TestFlight path reads this;
# scripts/build.sh (simulator, ad-hoc signing) needs none of it.

# Your Apple Developer Team ID, the 10-char string from developer.apple.com → Membership.
# Consumed two ways by scripts/ship-testflight.sh: exported into the environment so XcodeGen
# substitutes it into project.yml's DEVELOPMENT_TEAM, and rendered into ExportOptions.plist
# from ExportOptions.plist.template. Kept out of git so this public repo carries no link to a
# personal Apple account.
DEVELOPMENT_TEAM=

# App Store Connect API key used by `xcrun altool --upload-app`. Create it in App Store Connect →
# Users and Access → Integrations → App Store Connect API. The downloaded .p8 belongs at
# ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8 (never in the repo).
ASC_KEY_ID=
ASC_ISSUER_ID=
