# ─── Gains MCP server config ────────────────────────────────────────────────
# Copy to .env for local dev. In production set these as host secrets
# (`fly secrets set …`), never commit real values.

# Selects the HTTP transport (required for a hosted/connector deploy).
MCP_TRANSPORT=http

# Bearer token clients send + the secret all OAuth JWTs are signed from.
# Required, >=16 chars. Generate: openssl rand -hex 32
# The phone also sends this on POST /sync to push its data slice.
MCP_AUTH_TOKEN=

# Password the user types once when adding the server to your MCP client as a custom
# connector. Optional, leave empty to disable the OAuth/web-connector path and
# allow only static-bearer clients (a static-bearer client).
AUTH_PASSWORD=

# The server's public origin, used as the OAuth issuer. Set to your deployed URL
# (e.g. https://gains-yourname.fly.dev). Defaults to http://localhost:<port>.
PUBLIC_URL=

# Port to listen on. Defaults to 3000. (Hugging Face Spaces requires 7860.)
PORT=3000
